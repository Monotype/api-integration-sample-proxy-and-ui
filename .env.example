# Auth0 Configuration
AUTH0_CLIENT_SECRET=your_auth0_client_secret_here
AUTH0_CLIENT_ID=your_auth0_client_id_here

# Server Configuration
PORT=8081
# Set to true only when running behind a trusted reverse proxy
TRUST_PROXY=false
# Comma-separated origins allowed as OAuth callbacks (recommended outside local development)
# ALLOWED_REDIRECT_ORIGINS=https://your-app.example.com

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Session Configuration
SESSION_SECRET=your_session_secret_here # openssl rand -hex 64

# API Configuration
API_DOMAIN=api.monotype.com
